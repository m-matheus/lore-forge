# === Anthropic (research, outline, script, metadata) ===
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_RESEARCH=claude-sonnet-5
# ANTHROPIC_MODEL_SCRIPT=claude-opus-5

# === OpenAI (thumbnail key art) ===
OPENAI_API_KEY=sk-...

# === J1 TTS (narration, default) ===
# ElevenLabs voices through api.j1tts.com. VOICE_ID / voice.voice_id stay the ElevenLabs
# voice id; it is imported into the J1 account automatically on first use.
# TTS_PROVIDER=j1            # or "elevenlabs" to call ElevenLabs directly
J1_API_KEY=sk-j1tts-...

# === ElevenLabs (narration, TTS_PROVIDER=elevenlabs) ===
ELEVENLABS_API_KEY=...
# Model: eleven_multilingual_v2 (supports request stitching). eleven_flash_v2_5 = half price.
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Voice is set per channel in channels/{slug}/channel.json; this overrides it.
# VOICE_ID=

# === YouTube (footage + reference subtitles) ===
# Netscape-format cookies from a browser logged into YouTube ("Get cookies.txt LOCALLY").
# Re-export every few weeks. If downloads die with HTTP 403 around 10%: pip install -U yt-dlp
YOUTUBE_COOKIES_FILE=C:/path/to/www.youtube.com_cookies.txt
# YOUTUBE_QUALITY=edit
# YOUTUBE_MAX_HEIGHT=1080

# === General ===
# OUTPUT_BASE_DIR=output
# DEFAULT_CHANNEL=midnight-realm
